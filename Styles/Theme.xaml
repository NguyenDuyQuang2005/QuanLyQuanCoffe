<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. BẢNG MÀU CHUNG -->

    <SolidColorBrush x:Key="PrimaryBrush"
                     Color="#FF6F4E37"/>

    <SolidColorBrush x:Key="HeaderBrush"
                     Color="#FF362820"/>

    <SolidColorBrush x:Key="SidebarBrush"
                     Color="#FF4D372A"/>

    <SolidColorBrush x:Key="SidebarButtonBrush"
                     Color="#FF5C4231"/>

    <SolidColorBrush x:Key="SidebarHoverBrush"
                     Color="#FF806149"/>

    <SolidColorBrush x:Key="AppBackgroundBrush"
                     Color="#FFF7F2EC"/>

    <SolidColorBrush x:Key="StatusBarBrush"
                     Color="#FFE8DDD3"/>

    <SolidColorBrush x:Key="InputBorderBrush"
                     Color="#FFD8C9BC"/>

    <!-- Màu của menu đang được chọn -->
    <SolidColorBrush x:Key="SidebarActiveBrush"
                 Color="#FF947052"/>


    <!-- NÚT PHỤ: NỀN SÁNG, CHỮ TỐI -->

    <ControlTemplate x:Key="RoundedNeutralTemplate"
                 TargetType="Button">

        <Border x:Name="Chrome"
            CornerRadius="7"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">

            <ContentPresenter
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            Margin="{TemplateBinding Padding}"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome"
                    Property="Background"
                    Value="#FFE1D1C1"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome"
                    Property="Background"
                    Value="#FFCDB49E"/>
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome"
                    Property="BorderBrush"
                    Value="#FF6F4E37"/>
                <Setter TargetName="Chrome"
                    Property="BorderThickness"
                    Value="2"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome"
                    Property="Opacity"
                    Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!-- NÚT CHÍNH VÀ SIDEBAR: NỀN TỐI, CHỮ TRẮNG -->

    <ControlTemplate x:Key="RoundedAccentTemplate"
                 TargetType="Button">

        <Border x:Name="Chrome"
            CornerRadius="7"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">

            <ContentPresenter
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            Margin="{TemplateBinding Padding}"
            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
            RecognizesAccessKey="True"/>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome"
                    Property="Background"
                    Value="#FF8A6046"/>
            </Trigger>

            <!-- Menu đang được chọn -->
            <Trigger Property="Tag" Value="Selected">
                <Setter TargetName="Chrome"
                    Property="Background"
                    Value="#FF947052"/>
            </Trigger>

            <!-- Di chuột vào menu đang chọn -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Tag" Value="Selected"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>

                <Setter TargetName="Chrome"
                    Property="Background"
                    Value="#FFA67F60"/>
            </MultiTrigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome"
                    Property="Background"
                    Value="#FF563B2C"/>
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome"
                    Property="BorderBrush"
                    Value="#FFE8C7AA"/>
                <Setter TargetName="Chrome"
                    Property="BorderThickness"
                    Value="2"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome"
                    Property="Opacity"
                    Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!-- STYLE MẶC ĐỊNH CHO BUTTON -->

    <Style TargetType="Button">
        <Setter Property="Background" Value="#FFF1E8DF"/>
        <Setter Property="Foreground" Value="#FF4A3728"/>
        <Setter Property="BorderBrush" Value="#FFD4C3B5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template"
            Value="{StaticResource RoundedNeutralTemplate}"/>
    </Style>


    <!-- 2. STYLE CHO SIDEBAR -->

    <Style x:Key="SidebarButtonStyle"
       TargetType="Button">

        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="12,4"/>
        <Setter Property="Padding" Value="14,0"/>

        <Setter Property="HorizontalContentAlignment"
            Value="Left"/>

        <Setter Property="Background"
            Value="{StaticResource SidebarButtonBrush}"/>

        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template"
            Value="{StaticResource RoundedAccentTemplate}"/>

        <Style.Triggers>
            <Trigger Property="Tag" Value="Selected">
                <Setter Property="FontWeight"
                    Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- 3. STYLE NÚT CHỨC NĂNG -->

    <Style x:Key="PrimaryButtonStyle"
       TargetType="Button">

        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="Padding" Value="12,6"/>

        <Setter Property="Background"
            Value="{StaticResource PrimaryBrush}"/>

        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template"
            Value="{StaticResource RoundedAccentTemplate}"/>
    </Style>


    <!-- 4. STYLE Ô NHẬP LIỆU -->

    <Style x:Key="FormTextBoxStyle"
           TargetType="TextBox">

        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin"
                     Value="True">
                <Setter Property="BorderBrush"
                        Value="{StaticResource PrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 5. STYLE COMBOBOX -->

    <Style x:Key="FormComboBoxStyle"
           TargetType="ComboBox">

        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment"
                Value="Center"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource InputBorderBrush}"/>
    </Style>

    <!-- 6. STYLE BẢNG DỮ LIỆU -->

    <Style x:Key="TableDataGridStyle"
           TargetType="DataGrid">

        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="ColumnHeaderHeight" Value="34"/>
        <Setter Property="GridLinesVisibility"
                Value="Horizontal"/>
        <Setter Property="HeadersVisibility"
                Value="Column"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="AlternatingRowBackground"
                Value="#FFF8F5F1"/>
    </Style>


    <!-- MÀU SẮC TRẠNG THÁI BÀN -->

    <SolidColorBrush x:Key="TableFreeBrush"
                 Color="#FFE3F1DC"/>

    <SolidColorBrush x:Key="TableOccupiedBrush"
                 Color="#FFF5D8CA"/>

    <SolidColorBrush x:Key="TableFreeTextBrush"
                 Color="#FF385A31"/>

    <SolidColorBrush x:Key="TableOccupiedTextBrush"
                 Color="#FF803C2B"/>


    <!-- STYLE NÚT BÀN -->

    <Style x:Key="TableButtonStyle"
       TargetType="Button">

        <Setter Property="Width" Value="96"/>
        <Setter Property="Height" Value="76"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="4"/>

        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>

        <Setter Property="HorizontalContentAlignment"
            Value="Center"/>
        <Setter Property="VerticalContentAlignment"
            Value="Center"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.87"/>
                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.72"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>


    <Style x:Key="SecondaryButtonStyle"
       TargetType="Button">

        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="#FFEADFD5"/>
        <Setter Property="Foreground" Value="#FF4A3728"/>
        <Setter Property="BorderBrush" Value="#FFD4C3B5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template"
            Value="{StaticResource RoundedNeutralTemplate}"/>
    </Style>



</ResourceDictionary>
