<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Chuỗi kết nối SQLite: file CafeDB.db nằm cùng thư mục chạy ứng dụng -->
        <add name="CafeDB" connectionString="Data Source=CafeDB.db;Version=3;" />
    </connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
