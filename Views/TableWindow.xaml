<Window x:Class="QuanLiQuanCoffe.Views.TableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý bàn"
        Height="480" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F2EC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dgBan"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DgBan_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Tên bàn" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Tìm" Width="70" Click="BtnTim_Click"/>
                <TextBox x:Name="txtTim" Height="28" Margin="0,0,8,0"/>
            </DockPanel>
            <TextBlock Text="Tên bàn"/>
            <TextBox x:Name="txtTenBan" Height="28" Margin="0,4,0,8"/>
            <TextBlock x:Name="txtTrangThai" Foreground="#FF6B5344" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Thêm" Width="80" Click="BtnThem_Click"/>
                <Button Content="Sửa tên" Width="80" Click="BtnSua_Click"/>
                <Button Content="Xóa" Width="80" Click="BtnXoa_Click"/>
                <Button Content="Làm mới" Width="80" Click="BtnLamMoi_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
