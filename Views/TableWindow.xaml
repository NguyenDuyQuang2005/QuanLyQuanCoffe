<UserControl x:Class="QuanLiQuanCoffe.Views.TableWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tieu de cua man hinh quan ly ban -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="QUẢN LÝ BÀN"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="Quản lý danh sách bàn và xem trạng thái hiện tại."
                       FontSize="12"
                       Foreground="#FF806F61"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Danh sach ben trai, bieu mau ben phai -->
        <Grid Grid.Row="1" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Cot trai: tim kiem + bang su dung chieu cao con lai -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFF7F2EC"
                        BorderBrush="#FFE4D7CB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtTim"
                                 Grid.Column="0"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Margin="0,0,6,0"
                                 ToolTip="Nhập tên bàn để tìm kiếm"/>

                        <Button Grid.Column="1"
                                Content="Tìm"
                                Width="76"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnTim_Click"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="dgBan"
                          Grid.Row="1"
                          Margin="0,8,0,0"
                          Style="{StaticResource TableDataGridStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="DgBan_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã"
                                            Binding="{Binding Id}"
                                            Width="65"/>
                        <DataGridTextColumn Header="Tên bàn"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Trạng thái"
                                            Binding="{Binding Status}"
                                            Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Cot phai: bieu mau CRUD va thong tin trang thai -->
            <Border Grid.Column="2"
                    Background="#FFF7F2EC"
                    BorderBrush="#FFE4D7CB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Thông tin bàn"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FF4A3728"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Tên bàn"
                                   FontSize="12"
                                   Foreground="#FF6B5344"/>
                        <TextBox x:Name="txtTenBan"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Margin="0,4,0,10"/>

                        <!-- Trang thai duoc cap nhat boi code-behind khi chon ban -->
                        <TextBlock x:Name="txtTrangThai"
                                   FontSize="12"
                                   Foreground="#FF6B5344"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="btnThem"
                                Grid.Row="0" Grid.Column="0"
                                Content="Thêm"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,4,8"
                                Click="BtnThem_Click"/> 

                            <Button x:Name="btnSua"
                                Grid.Row="0" Grid.Column="1"
                                Content="Sửa tên"
                                Height="36"
                                Margin="4,0,0,8"
                                Click="BtnSua_Click"/>

                            <Button x:Name="btnXoa"
                                Grid.Row="1" Grid.Column="0"
                                Content="Xóa"
                                Height="36"
                                Margin="0,0,4,0"
                                Background="#FFF3DFDA"
                                Foreground="#FF8F3B32"
                                Click="BtnXoa_Click"/>

                            <Button Grid.Row="1" Grid.Column="1"
                                Content="Làm mới"
                                Height="36"
                                Margin="4,0,0,0"
                                Click="BtnLamMoi_Click"/>               
                        </Grid>

                        <TextBlock Text="Trạng thái bàn được thay đổi khi gọi món hoặc thanh toán."
                                   Foreground="#FF806F61"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
