<Window x:Class="QuanLiQuanCoffe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý quán cà phê"
        Width="1180" Height="700"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBackgroundBrush}">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="18,0">

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="Đăng xuất"
                            Width="90" Height="30"
                            Margin="0,0,8,0"
                            Click="MenuDangXuat_Click"/>

                    <Button Content="Thoát"
                            Width="70" Height="30"
                            Click="MenuThoat_Click"/>
                </StackPanel>

                <TextBlock Text="COFFEE MANAGER"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#FFFBEDE2"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- THÂN ỨNG DỤNG -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}">

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="ĐIỀU HƯỚNG"
                               Margin="26,0,0,12"
                               Foreground="#FFE6C7AF"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <Button x:Name="btnTrangChu"
                            Content="Trang chủ"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnTrangChu_Click"/>

                    <Button x:Name="btnGoiMon"
                            Content="Gọi món / Thanh toán"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnGoiMon_Click"/>

                    <Button x:Name="btnMon"
                            Content="Món / Danh mục"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnMon_Click"/>

                    <Button x:Name="btnBan"
                            Content="Quản lý bàn"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnBan_Click"/>

                    <Button x:Name="btnNhanVien"
                            Content="Nhân viên"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnNhanVien_Click"/>

                    <Button x:Name="btnThongKe"
                            Content="Thống kê"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnThongKe_Click"/>
                </StackPanel>
            </Border>

            <!-- KHU VỰC NỘI DUNG -->
            <Grid Grid.Column="1"
                  Background="#FFF7F2EC">

                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề vùng làm việc -->
                <Border Grid.Row="0"
                        Background="White"
                        Padding="18,0"
                        BorderBrush="#FFE8DED4"
                        BorderThickness="0,0,0,1">


                    <TextBlock x:Name="txtTieuDeTrang"
                               Text="Trang chủ"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#FF4A3728"
                               VerticalAlignment="Center"/> 

                </Border>

                <!-- Vùng hiển thị UserControl -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="10"
                        Margin="16"
                        Padding="12">

                    <Grid>
                        <!-- Trang chủ -->
                        <StackPanel x:Name="pnlTrangChu"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock x:Name="txtChao"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#FF4A3728"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="txtQuyen"
                                       FontSize="14"
                                       Foreground="#FF6B5344"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Chọn một chức năng ở menu bên trái để bắt đầu."
                                       FontSize="13"
                                       Foreground="#FF8A7464"
                                       Margin="0,16,0,0"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Nội dung được thay đổi -->
                        <ContentControl x:Name="noiDungChinh"
                                        Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="2"
                   Background="{StaticResource StatusBarBrush}">
            <TextBlock x:Name="txtNguoiDung"
                       Margin="8,0"/>
        </StatusBar>
    </Grid>
</Window>
