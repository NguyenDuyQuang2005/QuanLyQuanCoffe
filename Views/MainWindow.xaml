<Window x:Class="QuanLiQuanCoffe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý quán cà phê"
        Width="1180" Height="700"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBackgroundBrush}">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="18,0">

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="Đăng xuất"
                            Width="90" Height="30"
                            Margin="0,0,8,0"
                            Click="MenuDangXuat_Click"/>

                    <Button Content="Thoát"
                            Width="70" Height="30"
                            Click="MenuThoat_Click"/>
                </StackPanel>

                <TextBlock Text="COFFEE MANAGER"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#FFFBEDE2"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- THÂN ỨNG DỤNG -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}">

                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="ĐIỀU HƯỚNG"
                               Margin="26,0,0,12"
                               Foreground="#FFE6C7AF"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <Button x:Name="btnTrangChu"
                            Content="Trang chủ"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnTrangChu_Click"/>

                    <Button x:Name="btnGoiMon"
                            Content="Gọi món / Thanh toán"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnGoiMon_Click"/>

                    <Button x:Name="btnMon"
                            Content="Món / Danh mục"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnMon_Click"/>

                    <Button x:Name="btnBan"
                            Content="Quản lý bàn"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnBan_Click"/>

                    <Button x:Name="btnNhanVien"
                            Content="Nhân viên"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnNhanVien_Click"/>

                    <Button x:Name="btnThongKe"
                            Content="Thống kê"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="BtnThongKe_Click"/>
                </StackPanel>
            </Border>

            <!-- KHU VỰC NỘI DUNG -->
            <Grid Grid.Column="1"
                  Background="#FFF7F2EC">

                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề vùng làm việc -->
                <Border Grid.Row="0"
                        Background="White"
                        Padding="18,0"
                        BorderBrush="#FFE8DED4"
                        BorderThickness="0,0,0,1">


                    <TextBlock x:Name="txtTieuDeTrang"
                               Text="Trang chủ"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#FF4A3728"
                               VerticalAlignment="Center"/> 

                </Border>

                <!-- Vùng hiển thị UserControl -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="10"
                        Margin="16"
                        Padding="12">

                    <Grid>
                        <!-- Trang chủ -->
                        <ScrollViewer x:Name="pnlTrangChu"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8">

        <TextBlock Text="TỔNG QUAN QUÁN CÀ PHÊ"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#FF4A3728"/>

        <TextBlock x:Name="txtChao"
                   FontSize="15"
                   Foreground="#FF6B5344"
                   Margin="0,8,0,0"/>

        <TextBlock x:Name="txtQuyen"
                   FontSize="12"
                   Foreground="#FF8A7464"
                   Margin="0,4,0,0"/>

        <!-- Các chỉ số từ database -->
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#FFE4D7CB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Tổng số bàn"
                               Foreground="#FF806F61"
                               FontSize="13"/>
                    <TextBlock x:Name="txtTongSoBan"
                               Text="—"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#FF6F4E37"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#FFE4D7CB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Bàn có khách"
                               Foreground="#FF806F61"
                               FontSize="13"/>
                    <TextBlock x:Name="txtBanCoKhach"
                               Text="—"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#FFB56A45"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#FFE4D7CB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Bàn còn trống"
                               Foreground="#FF806F61"
                               FontSize="13"/>
                    <TextBlock x:Name="txtBanTrong"
                               Text="—"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#FF50845A"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thao tác nhanh: tái sử dụng các handler hiện tại -->
        <Border Background="White"
                BorderBrush="#FFE4D7CB"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Thao tác nhanh"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FF4A3728"/>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Gọi món / Thanh toán"
                            Width="190"
                            Height="40"
                            Margin="0,0,10,8"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnGoiMon_Click"/>
                    <Button Content="Quản lý bàn"
                            Width="150"
                            Height="40"
                            Margin="0,0,0,8"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnBan_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0">
            <Button Content="Làm mới số liệu"
                    Width="138"
                    Height="36"
                    Click="BtnLamMoiTongQuan_Click"/>
            <TextBlock x:Name="txtLanCapNhat"
                       Text="Chưa tải số liệu"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="#FF806F61"
                       FontSize="12"/>
        </StackPanel>

    </StackPanel>
</ScrollViewer>

                        <!-- Nội dung được thay đổi -->
                        <ContentControl x:Name="noiDungChinh"
                                        Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="2"
                   Background="{StaticResource StatusBarBrush}">
            <TextBlock x:Name="txtNguoiDung"
                       Margin="8,0"/>
        </StatusBar>
    </Grid>
</Window>
