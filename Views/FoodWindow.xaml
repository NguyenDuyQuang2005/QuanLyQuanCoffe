<Window x:Class="QuanLiQuanCoffe.Views.FoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý món và danh mục"
        Height="560" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F2EC">
    <TabControl Margin="12">
        <TabItem Header="Danh mục">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgDanhMuc"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="DgDanhMuc_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Tên danh mục" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Tìm" Width="70" Click="BtnTimDanhMuc_Click"/>
                        <TextBox x:Name="txtTimDanhMuc" Height="28" Margin="0,0,8,0"/>
                    </DockPanel>
                    <TextBlock Text="Tên danh mục"/>
                    <TextBox x:Name="txtTenDanhMuc" Height="28" Margin="0,4,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Thêm" Width="80" Click="BtnThemDanhMuc_Click"/>
                        <Button Content="Sửa" Width="80" Click="BtnSuaDanhMuc_Click"/>
                        <Button Content="Xóa" Width="80" Click="BtnXoaDanhMuc_Click"/>
                        <Button Content="Làm mới" Width="80" Click="BtnLamMoiDanhMuc_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Món">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgMon"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="DgMon_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Tên món" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="140"/>
                        <DataGridTextColumn Header="Giá" Binding="{Binding Price, StringFormat=N0}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtTimMon" Height="28" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cboLocDanhMuc" Grid.Column="1" Height="28" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Tìm" Width="70" Click="BtnTimMon_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Tên món"/>
                            <TextBox x:Name="txtTenMon" Height="28" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Danh mục"/>
                            <ComboBox x:Name="cboDanhMucMon" Height="28" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Giá (VNĐ)"/>
                            <TextBox x:Name="txtGia" Height="28" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Thêm" Width="80" Click="BtnThemMon_Click"/>
                        <Button Content="Sửa" Width="80" Click="BtnSuaMon_Click"/>
                        <Button Content="Xóa" Width="80" Click="BtnXoaMon_Click"/>
                        <Button Content="Làm mới" Width="80" Click="BtnLamMoiMon_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
