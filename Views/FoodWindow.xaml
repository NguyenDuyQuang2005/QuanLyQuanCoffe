<UserControl x:Class="QuanLiQuanCoffe.Views.FoodWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tieu de -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="QUẢN LÝ MÓN &amp; DANH MỤC"
                       FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="Quản lý danh mục và thực đơn của quán."
                       FontSize="12" Foreground="#FF806F61"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">

            <!-- TAB DANH MUC -->
            <TabItem Header="Danh mục">
                <Grid Margin="6,10,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tim kiem va danh sach -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#FFF7F2EC"
                                BorderBrush="#FFE4D7CB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtTimDanhMuc"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Margin="0,0,6,0"
                                         ToolTip="Nhập tên danh mục để tìm"/>

                                <Button Grid.Column="1"
                                        Content="Tìm"
                                        Width="76"
                                        Click="BtnTimDanhMuc_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="dgDanhMuc"
                                  Grid.Row="1"
                                  Margin="0,8,0,0"
                                  Style="{StaticResource TableDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionChanged="DgDanhMuc_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã"
                                                    Binding="{Binding Id}"
                                                    Width="65"/>

                                <DataGridTextColumn Header="Tên danh mục"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Form danh muc -->
                    <Border Grid.Column="2"
                            Padding="12"
                            CornerRadius="8"
                            Background="#FFF7F2EC"
                            BorderBrush="#FFE4D7CB"
                            BorderThickness="1">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <TextBlock Text="Thông tin danh mục"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#FF4A3728"
                                           Margin="0,0,0,14"/>

                                <TextBlock Text="Tên danh mục"
                                           FontSize="12"
                                           Foreground="#FF6B5344"/>

                                <TextBox x:Name="txtTenDanhMuc"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Margin="0,4,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Button x:Name="btnThemDanhMuc"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Content="Thêm"
                                            Margin="0,0,4,8"
                                            Click="BtnThemDanhMuc_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Button x:Name="btnSuaDanhMuc"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Content="Sửa"
                                            Margin="4,0,0,8"
                                            Height="36"
                                            Click="BtnSuaDanhMuc_Click"/>

                                    <Button x:Name="btnXoaDanhMuc"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Content="Xóa"
                                            Margin="0,0,4,0"
                                            Height="36"
                                            Background="#FFF3DFDA"
                                            Foreground="#FF8F3B32"
                                            Click="BtnXoaDanhMuc_Click"/>

                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Content="Làm mới"
                                            Margin="4,0,0,0"
                                            Height="36"
                                            Click="BtnLamMoiDanhMuc_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB MON -->
            <TabItem Header="Món">
                <Grid Margin="6,10,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tim kiem mon -->
                        <Border Grid.Row="0"
                                Background="#FFF7F2EC"
                                BorderBrush="#FFE4D7CB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtTimMon"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Margin="0,0,6,0"
                                         ToolTip="Nhập tên món để tìm"/>

                                <ComboBox Grid.Column="1"
                                          x:Name="cboLocDanhMuc"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          Margin="0,0,6,0"/>

                                <Button Grid.Column="2"
                                        Content="Tìm"
                                        Width="76"
                                        Click="BtnTimMon_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Danh sach mon -->
                        <DataGrid x:Name="dgMon"
                                  Grid.Row="1"
                                  Margin="0,8,0,0"
                                  Style="{StaticResource TableDataGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  SelectionChanged="DgMon_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã"
                                                    Binding="{Binding Id}"
                                                    Width="50"/>

                                <DataGridTextColumn Header="Tên món"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Danh mục"
                                                    Binding="{Binding CategoryName}"
                                                    Width="105"/>

                                <DataGridTextColumn Header="Giá (đ)"
                                                    Binding="{Binding Price, StringFormat=N0}"
                                                    Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Form mon -->
                    <Border Grid.Column="2"
                            Padding="12"
                            CornerRadius="8"
                            Background="#FFF7F2EC"
                            BorderBrush="#FFE4D7CB"
                            BorderThickness="1">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <TextBlock Text="Thông tin món"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#FF4A3728"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Tên món"
                                           FontSize="12"
                                           Foreground="#FF6B5344"/>

                                <TextBox x:Name="txtTenMon"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Margin="0,4,0,10"/>

                                <TextBlock Text="Danh mục"
                                           FontSize="12"
                                           Foreground="#FF6B5344"/>

                                <ComboBox x:Name="cboDanhMucMon"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          Margin="0,4,0,10"/>

                                <TextBlock Text="Giá (VNĐ)"
                                           FontSize="12"
                                           Foreground="#FF6B5344"/>

                                <TextBox x:Name="txtGia"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Margin="0,4,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Button x:Name="btnThemMon"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Content="Thêm"
                                            Margin="0,0,4,8"
                                            Click="BtnThemMon_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Button x:Name="btnSuaMon"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Content="Sửa"
                                            Margin="4,0,0,8"
                                            Height="36"
                                            Click="BtnSuaMon_Click"/>

                                    <Button x:Name="btnXoaMon"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Content="Xóa"
                                            Margin="0,0,4,0"
                                            Height="36"
                                            Background="#FFF3DFDA"
                                            Foreground="#FF8F3B32"
                                            Click="BtnXoaMon_Click"/>

                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Content="Làm mới"
                                            Margin="4,0,0,0"
                                            Height="36"
                                            Click="BtnLamMoiMon_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
