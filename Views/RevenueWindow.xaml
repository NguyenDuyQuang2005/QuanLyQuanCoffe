<UserControl x:Class="QuanLiQuanCoffe.Views.RevenueWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF7F2EC">

    <!-- Bố cục: tiêu đề, bộ lọc, tổng kết, danh sách hóa đơn -->
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TIÊU ĐỀ -->
        <StackPanel Grid.Row="0" Margin="0,2,0,0">
            <TextBlock Text="THỐNG KÊ DOANH THU"
                       Foreground="{StaticResource PrimaryBrush}"
                       FontSize="21"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Theo dõi các hóa đơn đã thanh toán theo ngày hoặc tháng."
                       Foreground="#FF806F61"
                       FontSize="12"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. BỘ LỌC THỜI GIAN -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="9"
                Padding="14"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Bộ lọc thời gian"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FF4A3728"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kiểu thống kê"
                                   Foreground="#FF6F4E37"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="cboKieu"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  SelectedIndex="1">
                            <ComboBoxItem Content="Theo ngày"/>
                            <ComboBoxItem Content="Theo tháng"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ngày tham chiếu"
                                   Foreground="#FF6F4E37"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpNgay"
                                    Height="32"
                                    BorderBrush="{StaticResource InputBorderBrush}"
                                    BorderThickness="1"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="Xem thống kê"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="128"
                            Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="12,0,0,0"
                            Click="BtnThongKe_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. TỔNG KẾT: nội dung được cập nhật trong ThongKe() -->
        <Border Grid.Row="4"
                Background="#FFF1E6DA"
                CornerRadius="9"
                Padding="14,10"
                BorderBrush="#FFE3CFBC"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="TỔNG KẾT KỲ BÁO CÁO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FF806F61"/>
                <TextBlock x:Name="txtTong"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- 4. DANH SÁCH: Grid.Row = * để chiếm chiều cao còn lại -->
        <Border Grid.Row="6"
                Background="White"
                CornerRadius="9"
                Padding="12"
                BorderBrush="{StaticResource InputBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                           Text="Danh sách hóa đơn đã thanh toán"
                           Foreground="#FF4A3728"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                        Content="Xuất Excel"
                        Width="105"
                        Height="32"
                        Background="#FF217346"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnXuatExcel_Click"/>

                    <Button Grid.Column="3"
                        Content="Xuất PDF"
                        Width="95"
                        Height="32"
                        Background="#FFB7472A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnXuatPDF_Click"/>
                </Grid>

                <DataGrid x:Name="dgDoanhThu"
                          Grid.Row="2"
                          Style="{StaticResource TableDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã HĐ"
                                            Binding="{Binding BillId}"
                                            Width="76"/>
                        <DataGridTextColumn Header="Thời gian thanh toán"
                                            Binding="{Binding DateCheckOut}"
                                            Width="170"/>
                        <DataGridTextColumn Header="Bàn"
                                            Binding="{Binding TableName}"
                                            Width="*"
                                            MinWidth="90"/>
                        <DataGridTextColumn Header="Giảm (%)"
                                            Binding="{Binding Discount}"
                                            Width="85"/>
                        <DataGridTextColumn Header="Doanh thu (đ)"
                                            Binding="{Binding Total, StringFormat=N0}"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
