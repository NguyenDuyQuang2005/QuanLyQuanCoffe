<Window x:Class="QuanLiQuanCoffe.Views.StaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý nhân viên"
        Height="500" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F2EC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dgNhanVien"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="DgNhanVien_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding UserName}" Width="160"/>
                <DataGridTextColumn Header="Tên hiển thị" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Quyền" Binding="{Binding TypeName}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Tên đăng nhập"/>
                <TextBox x:Name="txtTenDangNhap" Height="28" Margin="0,4,0,8"/>
                <TextBlock Text="Tên hiển thị"/>
                <TextBox x:Name="txtTenHienThi" Height="28" Margin="0,4,0,8"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Mật khẩu (để trống khi sửa = giữ nguyên)"/>
                <PasswordBox x:Name="txtMatKhau" Height="28" Margin="0,4,0,8"/>
                <TextBlock Text="Quyền"/>
                <ComboBox x:Name="cboQuyen" Height="28" Margin="0,4,0,8">
                    <ComboBoxItem Content="Nhân viên" Tag="0"/>
                    <ComboBoxItem Content="Admin" Tag="1"/>
                </ComboBox>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Thêm" Width="80" Click="BtnThem_Click"/>
                    <Button Content="Sửa" Width="80" Click="BtnSua_Click"/>
                    <Button Content="Xóa" Width="80" Click="BtnXoa_Click"/>
                    <Button Content="Làm mới" Width="80" Click="BtnLamMoi_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
